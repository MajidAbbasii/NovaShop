{
  "id": null,
  "title": "NovaShop — Business Metrics",
  "tags": ["novashop", "business", "commerce"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active API Requests",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(http_requests_in_progress)",
          "legendFormat": "Active Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "short",
        "title": "Count"
      }
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Request Rate by Status",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "reqps",
        "title": "Requests/sec"
      }
    },
    {
      "id": 3,
      "type": "text",
      "title": "Business metrics — not yet instrumented",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 6 },
      "content": "Custom business metrics (orders, revenue, products, users, cart operations) are not yet registered in the application. When they are added via prometheus-net's Metrics.CreateCounterGauge/Histogram API, update this dashboard to reference them.\n\nCurrently available metrics are HTTP-level only:\n- http_requests_total (by method, path, status)\n- http_request_duration_seconds_bucket (histogram)\n- http_requests_in_progress",
      "options": {
        "content": "<p>Custom business metrics (orders, revenue, products, users) are not yet instrumented. Add via prometheus-net Metrics API and update this dashboard.</p>",
        "mode": "html"
      }
    },
    {
      "id": 4,
      "type": "graph",
      "title": "Request Duration (P95)",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "P95 Latency (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "seconds",
        "title": "Seconds"
      }
    }
  ]
}
