{
  "id": null,
  "title": "NovaShop — API Performance",
  "tags": ["novashop", "api", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "graph",
      "title": "Request Rate",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "reqps",
        "title": "Requests/sec"
      }
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Error Rate",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5[0-9][0-9]\"}[5m])) by (service) / sum(rate(http_requests_total[5m])) by (service) * 100",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "percent",
        "title": "Error Rate (%)",
        "thresholds": [
          { "value": 5, "color": "orange" },
          { "value": 10, "color": "red" }
        ]
      }
    },
    {
      "id": 3,
      "type": "graph",
      "title": "P95 Response Time",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{service}} P95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "seconds",
        "title": "Response Time",
        "thresholds": [
          { "value": 0.5, "color": "orange" },
          { "value": 1.0, "color": "red" }
        ]
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "429 Rate Limited Requests",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=\"429\"}[5m]))",
          "legendFormat": "Rate Limited",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "reqps",
        "title": "429 Rate"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "5xx Errors",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5[0-9][0-9]\"}[5m]))",
          "legendFormat": "5xx Errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "reqps",
        "title": "5xx Errors/sec"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top Endpoints by Error Count",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum by (method, path) (rate(http_requests_total{status=~\"5[0-9][0-9]\"}[5m]))",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "unit": "reqps"
      }
    }
  ]
}
