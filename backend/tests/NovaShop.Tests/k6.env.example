# Test environment
ENVIRONMENT=dev
TEST_TIMEOUT=30s

# Advanced configuration
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=10s
EXPORT_INTERVAL=1s

# Dashboard and reporting
DASHBOARD=true
HTML_REPORT=report.html
JSON_REPORT=report.json
VERBOSE=true

# Test scenarios weights
PRODUCT_LIST_WEIGHT=30
PRODUCT_DETAIL_WEIGHT=25
ADD_TO_CART_WEIGHT=20
CHECKOUT_WEIGHT=15
LOGIN_WEIGHT=10
SEARCH_WEIGHT=10

# Database and cache configuration
