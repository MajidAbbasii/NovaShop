{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NovaShopDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "NovaShop",
    "Audience": "NovaShop",
    "ExpireMinutes": 60
  },
  "PaymentPolicy": {
    "OnlinePaymentEnabled": false,
    "WalletEnabled": false,
    "InPersonPaymentEnabled": true,
    "OrderCreationEnabled": true
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnectionString": "localhost:6379",
    "InstanceName": "NovaShop_"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "ProductCreatedQueue": "product-created-queue"
  },
  "RateLimit": {
    "Enabled": true,
    "DefaultLimit": 100,
    "DefaultWindowSeconds": 60,
    "AuthenticatedLimit": 300,
    "AdminLimit": 500,
    "AuthEndpointLimit": 5,
    "AuthEndpointWindowSeconds": 60,
    "RedisConnectionString": "",
    "InstanceName": "NovaShop_RateLimit_"
  },
  "ImageStorage": {
    "BasePath": "./wwwroot/images",
    "MaxSizeBytes": 5242880
  },
  "Development": {
    "EnableMassTransit": false
  }
}