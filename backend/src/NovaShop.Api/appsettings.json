{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "OtpEnabled": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NovaShopDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "dev-monitoring-key-change-in-production-USE-USER-SECRETS",
    "Issuer": "NovaShop",
    "Audience": "NovaShop",
    "ExpireMinutes": 60
  },
  "PaymentPolicy": {
    "OnlinePaymentEnabled": false,
    "WalletEnabled": false,
    "InPersonPaymentEnabled": true,
    "OrderCreationEnabled": true
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnectionString": "localhost:6379",
    "InstanceName": "NovaShop_"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "ProductCreatedQueue": "product-created-queue",
    "OrderEventsQueue": "order-events-queue"
  },
  "RateLimit": {
    "Enabled": true,
    "DefaultLimit": 100,
    "DefaultWindowSeconds": 60,
    "AuthenticatedLimit": 300,
    "AdminLimit": 500,
    "AuthEndpointLimit": 5,
    "AuthEndpointWindowSeconds": 60,
    "RedisConnectionString": "",
    "InstanceName": "NovaShop_RateLimit_"
  },
  "Sms": {
    "Provider": "Log",
    "StoreName": "نوواشاپ",
    "ApiKey": "",
    "SenderNumber": "",
    "BaseUrl": ""
  },
  "Hangfire": {
    "WorkerCount": 5,
    "RetryAttempts": 3,
    "RetryDelaysInSeconds": [ 30, 120, 300 ],
    "Queues": [ "critical", "default", "notifications", "sms", "maintenance" ]
  },
  "Jobs": {
    "LowStockThreshold": 5,
    "CustomDollReminderAfterDays": 3
  }
}
