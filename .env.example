# NovaShop — Environment Variable Template
# Copy to `.env` and fill with real values for local development.
# NEVER commit the real `.env` file. Production secrets must be supplied
# through deployment environment variables / a secrets manager.

# --- Database ---
# SQL Server connection string (LocalDB for dev, full SQL Server for prod)
DATABASE_CONNECTION_STRING=Server=(localdb)\mssqllocaldb;Database=NovaShopDb;Trusted_Connection=True;MultipleActiveResultSets=true

# --- JWT ---
# Must be a long, random string. Used by both API and Gateway (must match).
JWT_KEY=
JWT_ISSUER=NovaShop
JWT_AUDIENCE=NovaShop
JWT_EXPIRE_MINUTES=60

# --- Cache (optional Redis) ---
CACHE_PROVIDER=Memory
REDIS_CONNECTION_STRING=localhost:6379

# --- RabbitMQ / MassTransit (optional) ---
RABBITMQ_HOST=localhost
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- SMS (Kavenegar) ---
SMS_PROVIDER=Log
SMS_API_KEY=
SMS_SENDER_NUMBER=

# --- Hangfire dashboard access (optional) ---
HANGFIRE_DASHBOARD_ACCESS_KEY=

# --- Image storage ---
IMAGE_STORAGE_BASE_PATH=./wwwroot/images
IMAGE_STORAGE_MAX_SIZE_BYTES=5242880

# --- Frontend ---
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:5100
