# NovaShop — Environment Variable Template
# Copy to `.env` (DO NOT COMMIT) and fill with real values for local development.
# Production secrets MUST be supplied through deployment environment variables /
# a secrets manager (Render / Azure Key Vault), never committed.

# Nested .NET configuration uses double-underscore (`__`) env-var overrides, e.g.
# "Jwt": { "Key": "..." }  ->  Jwt__Key

# --- Database (PostgreSQL) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=NovaShopDb;Username=novashop;Password=novashop-dev;TrustServerCertificate=true

# --- JWT (must match between API and Gateway) ---
Jwt__Key=
Jwt__Issuer=NovaShop
Jwt__Audience=NovaShop
Jwt__ExpireMinutes=60

# --- Cache (Redis optional; Memory by default) ---
Cache__Provider=Memory
Cache__RedisConnectionString=localhost:6379

# --- RabbitMQ / MassTransit (optional) ---
RabbitMq__Host=localhost
RabbitMq__VirtualHost=/
RabbitMq__Username=guest
RabbitMq__Password=guest

# --- SMS (Kavenegar) ---
# Provider: Log | Mock | Kavenegar
Sms__Provider=Log
Sms__ApiKey=
Sms__SenderNumber=
Sms__StoreName=نوواشاپ

# --- CORS (Gateway) — comma-separated allowed origins ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5100

# --- Gateway bind URL (API Gateway) ---
# Render injects the port; locally override with e.g. http://localhost:5100
GATEWAY_URL=http://localhost:5100

# --- Image storage (local filesystem; ephemeral on Render Free) ---
# BasePath is read from appsettings ImageStorage:BasePath (./wwwroot/images).
# No env override is required; this is informational.
# IMAGE_STORAGE_BASE_PATH=./wwwroot/images
