# NovaShop .dockerignore
# Goal: shrink the Docker build context. The API and Gateway images are
# .NET projects under backend/src; they do NOT need the frontend, node_modules,
# build output, secrets, logs, or test artifacts.

# ---- Source control / tooling ----
.git
.gitignore
**/.git
**/.vs
**/.vscode
**/.idea

# ---- Frontend (Next.js) — not required to build the .NET API/Gateway ----
frontend
**/node_modules
**/.next
**/.output
**/dist

# ---- .NET build output (will be regenerated by dotnet build/publish) ----
**/bin
**/obj
**/PublishOutput

# ---- Local DB / secrets / env / logs / temp ----
**/*.db
**/*.sqlite
**/*.mdf
**/*.ldf
**/secrets.json
**/.env
**/.env.*
**/logs
**/*.log
**/*.tmp

# ---- Test / CI / docs / monitoring artifacts ----
**/*.Tests
**/tests
**/TestResults
.github
**/playwright-report
**/test-results
**/coverage
**/*.md

# Keep (explicitly NOT excluded): everything under backend/src needed by the
# Dockerfiles: *.csproj, source, EF Migrations, docker-entrypoint.sh, appsettings*.json
